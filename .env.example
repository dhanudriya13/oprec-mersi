# ---------------------------------------------------------------------------
# MERSI SIFORS UNDIKSHA — environment variables
# Copy this file to `.env.local` for local development.
# ---------------------------------------------------------------------------

# The official external MERSI recruitment form.
# While this is empty, every "Apply Now" button stays disabled and the site
# shows an explanatory notice instead of sending visitors to a dead link.
NEXT_PUBLIC_APPLICATION_URL=

# Canonical production URL (no trailing slash).
# Used for canonical tags, sitemap.xml, robots.txt and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=https://mersi-sifors.vercel.app
